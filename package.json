{
  "name": "project-cost-calculator",
  "productName": "Project Cost Calculator",
  "version": "1.0.0",
  "description": "Простий калькулятор вартості проєкту за годинами та рейтами",
  "main": "main.js",
  "author": "Your Name",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder"
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.example.projectcostcalculator",
    "productName": "Project Cost Calculator",
    "files": [
      "main.js",
      "index.html",
      "styles.css",
      "renderer.js"
    ],
    "mac": {
      "category": "public.app-category.productivity",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ]
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    }
  },
  "allowScripts": {
    "electron@33.4.11": true
  }
}
